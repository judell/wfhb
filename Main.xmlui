<App name="WFHB Event Moderator" var.refreshKey="{0}" var.newPage="{0}" var.visiblePage="{0}" var.excludedPage="{0}" var.pageSize="{50}" var.publishStatus="{''}" var.fileSha="{''}">

  <DataSource
    id="events"
    url="{window.SUPABASE_URL + '/rest/v1/events?select=id,title,start_time,end_time,location,description,url,source,source_uid,category,image_url,all_day,created_at&order=start_time.asc&city=eq.bloomington&start_time=gte.' + window.fromDate + '&start_time=lte.' + window.toDate}"
    headers="{{
      apikey: window.SUPABASE_KEY,
      'Cache-Control': 'no-cache, no-store, must-revalidate'
    }}"
  />

  <DataSource
    id="sourceNames"
    url="{window.SUPABASE_URL + '/rest/v1/source_names?select=name,event_count&city=eq.bloomington&order=name.asc'}"
    headers="{{
      apikey: window.SUPABASE_KEY
    }}"
  />

  <!-- Track unsaved changes: refreshKey increments on every mutation -->
  <ChangeListener
    listenTo="{refreshKey}"
    onDidChange="() => { unsavedChanges = window.hasUnsavedChanges(); changeSummary = window.getChangeSummary() }"
  />

  <!-- GET current file SHA, then PUT via window.saveToGitHub -->
  <APICall
    id="getSha"
    method="get"
    url="{'https://api.github.com/repos/judell/wfhb/contents/excluded.json'}"
    headers="{{
      Authorization: 'Bearer ' + window.getGitHubToken(),
      Accept: 'application/vnd.github.v3+json'
    }}"
  >
    <event name="success" value="(result) => { window.saveToGitHub(result.sha, (msg) => { publishStatus = msg; if (msg.indexOf('Saved') === 0) { window.markSaved(); unsavedChanges = false; changeSummary = '' } }) }" />
    <event name="error" value="() => { window.saveToGitHub('', (msg) => { publishStatus = msg; if (msg.indexOf('Saved') === 0) { window.markSaved(); unsavedChanges = false; changeSummary = '' } }) }" />
  </APICall>

  <!-- Detail dialog -->
  <ModalDialog id="detailDialog">
    <VStack gap="$space-2">
      <Text fontWeight="600" fontSize="$fontSize-lg" value="{$param.title}" />
      <Text fontSize="$fontSize-sm" color="$color-text-secondary" value="{window.formatDateTime($param.start_time, $param.all_day)}" />
      <Text when="{$param.location}" fontSize="$fontSize-sm" value="{$param.location}" />
      <Text when="{$param.source}" fontSize="$fontSize-sm" fontStyle="italic" color="$color-text-tertiary" value="{$param.source}" />
      <Image when="{$param.image_url}" src="{$param.image_url}" width="100%" fit="contain" />
      <Markdown when="{$param.description}" fontSize="$fontSize-sm" content="{$param.description}" />
      <Link when="{$param.url}" to="{$param.url}" target="_blank">
        <Text fontSize="$fontSize-sm" value="Event link" />
      </Link>
    </VStack>
  </ModalDialog>

  <!-- Settings dialog for GitHub token -->
  <ModalDialog id="settingsDialog" title="Settings" var.tokenInput="{window.getGitHubToken()}" minWidth="min(500px, 90vw)">
    <VStack gap="$space-3">
      <Text fontSize="$fontSize-sm" value="GitHub personal access token (needs repo scope):" />
      <TextBox
        initialValue="{window.getGitHubToken()}"
        placeholder="ghp_..."
        onDidChange="(val) => tokenInput = val"
      />
      <HStack verticalAlignment="center" gap="$space-2" marginTop="$space-2">
        <Checkbox
          initialValue="{window.getRequireApproval()}"
          onDidChange="(val) => window.setRequireApproval(val)"
        />
        <Text fontSize="$fontSize-sm" value="Require approval for new events (hide from viewer until reviewed)" />
      </HStack>
      <HStack gap="$space-2">
        <Button label="Save" onClick="() => { window.setGitHubToken(tokenInput); settingsDialog.close() }" />
        <Button label="Cancel" variant="outlined" onClick="settingsDialog.close()" />
      </HStack>
      <HStack gap="$space-2" marginTop="$space-2">
        <Button label="Reset last reviewed (−24h)" variant="outlined" size="sm" onClick="() => { window.setLastReviewed(new Date(Date.now() - 24*60*60*1000).toISOString()); refreshKey = refreshKey + 1; settingsDialog.close() }" />
      </HStack>
    </VStack>
  </ModalDialog>

  <!-- Help dialog -->
  <DataSource
    id="readmeData"
    url="{'https://api.github.com/repos/judell/wfhb/readme'}"
    headers="{{
      Accept: 'application/vnd.github.v3+json'
    }}"
  />

  <Theme maxWidth-ModalDialog="90%" maxHeight-ModalDialog="90vh">
  <ModalDialog id="helpDialog" showCloseButton="true">
    <Markdown when="{readmeData.value}" content="{window.decodeBase64(readmeData.value.content)}" fontSize="$fontSize-sm" lineHeight="1.3" padding="0" margin="0" />
  </ModalDialog>
  </Theme>

  <!-- Confirm mark reviewed -->
  <ModalDialog id="confirmReviewDialog" title="Confirm">
    <VStack gap="$space-3">
      <Text fontSize="$fontSize-sm" value="Mark all new events as included? This will make them visible in the viewer." />
      <HStack gap="$space-2">
        <Button label="Yes, mark all included" onClick="() => { window.markAllReviewed(events.value); refreshKey = refreshKey + 1; confirmReviewDialog.close() }" />
        <Button label="Cancel" variant="outlined" onClick="confirmReviewDialog.close()" />
      </HStack>
    </VStack>
  </ModalDialog>

  <VStack padding="$space-4" gap="$space-4" maxWidth="800px" width="100%">

    <HStack verticalAlignment="center" gap="$space-2">
      <Text variant="header" value="WFHB Event Moderator" />
      <Icon name="l-settings" tooltip="Settings" aria-label="Settings" width="20px" height="20px" color="$color-surface-500" cursor="pointer" onClick="settingsDialog.open()" />
      <Icon name="message-circle-question" tooltip="Help" aria-label="Help" width="20px" height="20px" color="$color-surface-500" cursor="pointer" onClick="helpDialog.open()" />
      <Inspector aria-label="Inspector" />
    </HStack>
    <HStack verticalAlignment="center" gap="$space-3" wrapContent="true">
      <Button label="Save choices" size="sm" enabled="{unsavedChanges}" onClick="() => { publishStatus = 'Saving...'; getSha.execute() }" />
      <Text when="{unsavedChanges}" fontSize="$fontSize-sm" color="$color-text-secondary" value="{changeSummary}" />
    </HStack>
    <Text when="{publishStatus}" fontSize="$fontSize-sm" color="$color-text-secondary" value="{publishStatus}" animation="fadeout" animationOptions="{{ duration: 3000, delay: 1000, fillMode: 'forwards' }}" />
    <ChangeListener listenTo="{publishStatus}" debounceWaitInMs="{4000}" onDidChange="() => { if (publishStatus) publishStatus = '' }" />

    <Tabs tabAlignment="stretch" onDidChange="(idx) => { if (idx === 2) { newPage = 0 } else if (idx === 3) { visiblePage = 0 } else if (idx === 4) { excludedPage = 0 } }">
      <property name="headerTemplate">
        <VStack horizontalAlignment="center" gap="0">
          <Text value="{$header.label.split('(')[0].trim()}" fontSize="$fontSize-sm" fontWeight="600" />
          <Text when="{$header.label.indexOf('(') >= 0}" value="{'(' + $header.label.split('(')[1]}" fontSize="$fontSize-xs" color="$color-text-secondary" />
        </VStack>
      </property>

      <!-- SOURCES TAB -->
      <TabItem label="{'Sources (' + window.getExcludedCount(events.value, refreshKey) + ' excluded)'}">
        <VStack gap="$space-2" padding="$space-2 0">
          <Text fontSize="$fontSize-sm" color="$color-text-secondary" value="All sources included by default. Uncheck to exclude a source from the viewer." />
          <Items data="{window.mergeSourceExclusions(sourceNames.value, refreshKey)}">
            <HStack verticalAlignment="center" gap="$space-2" padding="$space-1 0" opacity="{$item.excluded ? 0.5 : 1}">
              <Checkbox
                initialValue="{!$item.excluded}"
                onDidChange="() => { window.toggleSource($item.name); refreshKey = refreshKey + 1 }"
              />
              <Text fontSize="$fontSize-sm" fontWeight="{$item.excluded ? '400' : '500'}" value="{$item.name + ' (' + $item.event_count + ')'}" />
            </HStack>
          </Items>
        </VStack>
      </TabItem>

      <!-- CATEGORIES TAB -->
      <TabItem label="{'Categories (' + window.getExcludedCategoryCount(events.value, refreshKey) + ' excluded)'}">
        <VStack gap="$space-2" padding="$space-2 0">
          <Text fontSize="$fontSize-sm" color="$color-text-secondary" value="All categories included by default. Uncheck to exclude a category from the viewer." />
          <Items data="{window.mergeCategoryExclusions(events.value, refreshKey)}">
            <HStack verticalAlignment="center" gap="$space-2" padding="$space-1 0" opacity="{$item.excluded ? 0.5 : 1}">
              <Checkbox
                initialValue="{!$item.excluded}"
                onDidChange="() => { window.toggleCategory($item.name); refreshKey = refreshKey + 1 }"
              />
              <Text fontSize="$fontSize-sm" fontWeight="{$item.excluded ? '400' : '500'}" value="{$item.name + ' (' + $item.event_count + ')'}" />
            </HStack>
          </Items>
        </VStack>
      </TabItem>

      <!-- NEW TAB -->
      <TabItem label="{'New (' + (events.value ? window.getNewEvents(events.value, refreshKey).length + (window.totalOccurrences(window.getNewEvents(events.value, refreshKey)) !== window.getNewEvents(events.value, refreshKey).length ? ' / ' + window.totalOccurrences(window.getNewEvents(events.value, refreshKey)) + ' occurrences' : '') : 0) + ')'}">
        <VStack gap="$space-2" padding="$space-2 0">
          <HStack verticalAlignment="center" gap="$space-3">
            <Button
              when="{window.getRequireApproval()}"
              label="Mark all included"
              variant="outlined"
              size="sm"
              enabled="{events.value && window.getNewEvents(events.value, refreshKey).length > 0}"
              onClick="confirmReviewDialog.open()"
            />
            <Text when="{window.getLastReviewed()}" fontSize="$fontSize-sm" color="$color-text-secondary" value="{'Last reviewed: ' + window.formatDateTime(window.getLastReviewed(), false)}" />
            <Text when="{!window.getLastReviewed()}" fontSize="$fontSize-sm" color="$color-text-secondary" value="Not yet reviewed." />
            <Text when="{!window.getRequireApproval()}" fontSize="$fontSize-sm" color="$color-text-tertiary" value="(New events show in viewer immediately. Enable approval in Settings to require review.)" />
          </HStack>
          <Text when="{window.getLastReviewed() && events.value && window.getNewEvents(events.value, refreshKey).length === 0}" fontSize="$fontSize-sm" color="$color-text-secondary" value="No new events since last review." />
          <Pagination
            when="{events.value && window.getNewEvents(events.value, refreshKey).length > pageSize}"
            itemCount="{window.getNewEvents(events.value, refreshKey).length}"
            pageSize="{pageSize}"
            pageIndex="{newPage}"
            onPageDidChange="(page) => { newPage = page }"
            maxVisiblePages="{5}"
            showPageSizeSelector="false"
          />
          <Items data="{events.value ? window.pageSlice(window.getNewEvents(events.value, refreshKey), newPage, pageSize) : []}">
            <Card padding="$space-3" marginBottom="$space-2">
              <VStack gap="$space-1">
                <Text fontSize="$fontSize-sm" color="$color-text-secondary" value="{window.formatDateTime($item.start_time, $item.all_day)}" />
                <Link when="{$item.url}" to="{$item.url}" target="_blank">
                  <Text fontWeight="600" overflowMode="flow" value="{$item.title}" />
                </Link>
                <Text when="{!$item.url}" fontWeight="600" value="{$item.title}" />
                <Text when="{$item.location}" fontSize="$fontSize-sm" color="$color-text-secondary" value="{$item.location}" />
                <Text fontSize="$fontSize-sm" color="$color-text-tertiary" fontStyle="italic" value="{$item.source}" />
                <Text when="{$item._occurrences}" fontSize="$fontSize-xs" color="$color-text-tertiary" value="{'Recurring (' + $item._occurrences + ' occurrences)'}" />
                <Text
                  when="{$item.description || $item.image_url}"
                  fontSize="$fontSize-sm"
                  color="$color-text-secondary"
                  cursor="pointer"
                  onClick="detailDialog.open($item)"
                  value="{window.getSnippet($item.description) + ' \u24d8'}"
                />
                <HStack gap="$space-2" marginTop="$space-2">
                  <Button label="Include" size="sm" onClick="() => { window.includeGroup($item); window.reviewGroup($item); refreshKey = refreshKey + 1 }" />
                </HStack>
              </VStack>
            </Card>
          </Items>
        </VStack>
      </TabItem>

      <!-- VISIBLE TAB -->
      <TabItem label="{'Included (' + (events.value ? window.getVisibleEvents(events.value, refreshKey).length + (window.totalOccurrences(window.getVisibleEvents(events.value, refreshKey)) !== window.getVisibleEvents(events.value, refreshKey).length ? ' / ' + window.totalOccurrences(window.getVisibleEvents(events.value, refreshKey)) + ' occurrences' : '') : 0) + ')'}">
        <VStack gap="$space-2" padding="$space-2 0">
          <Text fontSize="$fontSize-sm" color="$color-text-secondary" value="Events that will appear in the viewer. Exclude individual events to hide them." />
          <Pagination
            when="{events.value && window.getVisibleEvents(events.value, refreshKey).length > pageSize}"
            itemCount="{window.getVisibleEvents(events.value, refreshKey).length}"
            pageSize="{pageSize}"
            pageIndex="{visiblePage}"
            onPageDidChange="(page) => { visiblePage = page }"
            maxVisiblePages="{5}"
            showPageSizeSelector="false"
          />
          <Items data="{events.value ? window.pageSlice(window.getVisibleEvents(events.value, refreshKey), visiblePage, pageSize) : []}">
            <Card padding="$space-3" marginBottom="$space-2">
              <VStack gap="$space-1">
                <Text fontSize="$fontSize-sm" color="$color-text-secondary" value="{window.formatDateTime($item.start_time, $item.all_day)}" />
                <Link when="{$item.url}" to="{$item.url}" target="_blank">
                  <Text fontWeight="600" overflowMode="flow" value="{$item.title}" />
                </Link>
                <Text when="{!$item.url}" fontWeight="600" value="{$item.title}" />
                <Text when="{$item.location}" fontSize="$fontSize-sm" color="$color-text-secondary" value="{$item.location}" />
                <Text fontSize="$fontSize-sm" color="$color-text-tertiary" fontStyle="italic" value="{$item.source}" />
                <Text when="{$item._occurrences}" fontSize="$fontSize-xs" color="$color-text-tertiary" value="{'Recurring (' + $item._occurrences + ' occurrences)'}" />
                <Text
                  when="{$item.description || $item.image_url}"
                  fontSize="$fontSize-sm"
                  color="$color-text-secondary"
                  cursor="pointer"
                  onClick="detailDialog.open($item)"
                  value="{window.getSnippet($item.description) + ' \u24d8'}"
                />
                <HStack gap="$space-2" marginTop="$space-2">
                  <Button label="Exclude" variant="outlined" size="sm" onClick="() => { window.excludeGroup($item); refreshKey = refreshKey + 1 }" />
                </HStack>
              </VStack>
            </Card>
          </Items>
        </VStack>
      </TabItem>

      <!-- REJECTED TAB -->
      <TabItem label="{'Excluded Events (' + (events.value ? window.getExcludedEvents(events.value, refreshKey).length + (window.totalOccurrences(window.getExcludedEvents(events.value, refreshKey)) !== window.getExcludedEvents(events.value, refreshKey).length ? ' / ' + window.totalOccurrences(window.getExcludedEvents(events.value, refreshKey)) + ' occurrences' : '') : 0) + ')'}">
        <VStack gap="$space-2" padding="$space-2 0">
          <Text when="{events.value && window.getExcludedEvents(events.value, refreshKey).length === 0}" fontSize="$fontSize-sm" color="$color-text-secondary" value="No excluded events." />
          <Pagination
            when="{events.value && window.getExcludedEvents(events.value, refreshKey).length > pageSize}"
            itemCount="{window.getExcludedEvents(events.value, refreshKey).length}"
            pageSize="{pageSize}"
            pageIndex="{excludedPage}"
            onPageDidChange="(page) => { excludedPage = page }"
            maxVisiblePages="{5}"
            showPageSizeSelector="false"
          />
          <Items data="{events.value ? window.pageSlice(window.getExcludedEvents(events.value, refreshKey), excludedPage, pageSize) : []}">
            <Card padding="$space-3" marginBottom="$space-2">
              <VStack gap="$space-1">
                <Text fontSize="$fontSize-sm" color="$color-text-secondary" value="{window.formatDateTime($item.start_time, $item.all_day)}" />
                <Text fontWeight="600" overflowMode="flow" value="{$item.title}" />
                <Text when="{$item.location}" fontSize="$fontSize-sm" color="$color-text-secondary" value="{$item.location}" />
                <Text fontSize="$fontSize-sm" color="$color-text-tertiary" fontStyle="italic" value="{$item.source}" />
                <Text when="{$item._occurrences}" fontSize="$fontSize-xs" color="$color-text-tertiary" value="{'Recurring (' + $item._occurrences + ' occurrences)'}" />
                <HStack gap="$space-2" marginTop="$space-2">
                  <Button label="Include" variant="outlined" size="sm" onClick="() => { window.includeGroup($item); refreshKey = refreshKey + 1 }" />
                </HStack>
              </VStack>
            </Card>
          </Items>
        </VStack>
      </TabItem>

    </Tabs>

  </VStack>
</App>
